---
import Base from '../layouts/Base.astro';
import RedeDorBooking from '../components/booking/RedeDorBooking';

const title = 'Agendar Ambulância | Rede D\'Or + Savior';
const description = 'Solicite ou agende uma ambulância particular pela Rede D\'Or. UTI móvel, básica ou neonatal. Formulário rápido, resposta imediata. (21) 3171-3030.';
---

<Base
  title={title}
  description={description}
  canonical="https://www.savior.com.br/agendar-rededor"
  noindex
>
  <main id="main">
    <RedeDorBooking client:load />
  </main>
</Base>
