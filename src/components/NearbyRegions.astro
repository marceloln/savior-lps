---
// ============================================================
// NearbyRegions — Links para regiões próximas
// Props: regions (GeoNearbyRegion[])
// Retorna vazio se regions estiver vazio.
// ============================================================

import type { GeoNearbyRegion } from '../data/geo-regions';

interface Props {
  regions: GeoNearbyRegion[];
}

const { regions } = Astro.props;

if (regions.length === 0) {
  // Nada a renderizar
}
---

{regions.length > 0 && (
  <section class="nearby-section">
    <div class="wrap">
      <div class="nearby-head">
        <span class="eyebrow">REGIÕES PRÓXIMAS</span>
        <h2 class="nearby-h2">Atendemos toda a região. Veja também:</h2>
      </div>

      <div class="nearby-cards">
        {regions.map((region) => (
          <a
            class="nearby-card"
            href={`/ambulancia-rj/${region.slug}`}
            aria-label={`Ver ambulância em ${region.name}`}
          >
            <div class="nearby-name">{region.name}</div>
            <div class="nearby-highlight">{region.highlight}</div>
            <span class="nearby-link">Ver página →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .nearby-section {
    padding: var(--space-block) 0;
    background: var(--cream-light);
    border-top: 1px solid var(--cream-dark);
  }

  .nearby-head {
    max-width: 640px;
    margin-bottom: 32px;
  }

  .nearby-head .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .nearby-h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(20px, 2.5vw, 30px);
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--navy);
  }

  /* Cards: flex row */
  .nearby-cards {
    display: flex;
    flex-direction: row;
    gap: 2px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--cream-dark);
  }

  /* Card individual */
  .nearby-card {
    background: white;
    padding: 20px 24px;
    border-left: 3px solid var(--green);
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .nearby-card:hover {
    background: var(--cream-light);
  }

  .nearby-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
  }

  .nearby-highlight {
    font-size: 12px;
    color: var(--gray);
    line-height: 1.4;
    flex: 1;
  }

  .nearby-link {
    font-size: 12px;
    color: var(--green-dark);
    font-weight: 600;
    margin-top: 8px;
    transition: color 0.15s;
  }

  .nearby-card:hover .nearby-link {
    color: var(--navy);
  }

  /* Mobile: empilhar verticalmente */
  @media (max-width: 640px) {
    .nearby-cards {
      flex-direction: column;
    }

    .nearby-card {
      flex-grow: unset;
      flex-basis: auto;
    }
  }
</style>
