---
// ============================================================
// HospitalGrid — Grid de hospitais e clínicas da região
// Props: hospitals (GeoHospital[]), regionName
// ============================================================

import type { GeoHospital } from '../data/geo-regions';

interface Props {
  hospitals: GeoHospital[];
  regionName: string;
}

const { hospitals, regionName } = Astro.props;

function getNetworkClass(network: string): string {
  if (network.includes("Rede D'Or")) return 'net-dor';
  if (network === 'SUS' || network.includes('SUS')) return 'net-sus';
  if (network.includes('Americas')) return 'net-americas';
  if (network === 'Municipal') return 'net-municipal';
  return 'net-particular';
}

function isSus(network: string): boolean {
  return network === 'SUS' || network.includes('SUS') || network === 'Municipal';
}
---

<section class="hosp-section">
  <div class="wrap">
    <div class="hosp-head">
      <span class="eyebrow">HOSPITAIS E CLÍNICAS</span>
      <h2 class="hosp-h2">Remoções de e para <em>estas unidades</em></h2>
      <p class="hosp-desc">
        Atendemos as principais unidades hospitalares de {regionName} e adjacências, tanto para emergências quanto para remoções programadas e transferências inter-hospitalares.
      </p>
    </div>

    <div class="hosp-grid">
      {hospitals.map((hospital) => (
        <div class={`hosp-card ${getNetworkClass(hospital.network)}`}>
          <div class="hosp-avatar-wrap">
            <div
              class={`hosp-initials ${getNetworkClass(hospital.network)}`}
              style={`--bg: ${hospital.color.bg}; --fg: ${hospital.color.text};`}
              aria-hidden="true"
            >
              <span class="initials-text">{hospital.initials}</span>
              {isSus(hospital.network) && (
                <span class="sus-label">SUS</span>
              )}
            </div>
          </div>
          <div class="hosp-info">
            <div class="hosp-name-row">
              <div class="hosp-name">{hospital.name}</div>
              {hospital.emergency24h && (
                <span class="badge-24h" aria-label="Emergência 24 horas">
                  <span class="dot-24h" aria-hidden="true"></span>
                  24h
                </span>
              )}
            </div>
            <div class="hosp-detail">{hospital.detail}</div>
            <div class="hosp-bottom">
              <span class="hosp-tag">{hospital.tag}</span>
              {hospital.network.includes("Rede D'Or") && (
                <span class="net-badge badge-dor">D'Or</span>
              )}
              {isSus(hospital.network) && (
                <span class="net-badge badge-sus">SUS</span>
              )}
              {hospital.network.includes('Americas') && (
                <span class="net-badge badge-americas">Américas</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="hosp-footer">
      Também removemos pacientes de {regionName} para hospitais de qualquer outra região: Zona Norte, Barra, Niterói ou outro estado.
    </p>
  </div>
</section>

<style>
  .hosp-section {
    padding: var(--space-block) 0;
    background: white;
  }

  .hosp-head {
    max-width: 640px;
    margin-bottom: 40px;
  }

  .hosp-head .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .hosp-h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(22px, 3vw, 34px);
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--navy);
    margin-bottom: 14px;
  }

  .hosp-h2 em {
    font-style: normal;
    color: var(--green-dark);
  }

  .hosp-desc {
    font-size: 15px;
    color: var(--gray);
    line-height: 1.6;
  }

  /* Grid */
  .hosp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--cream-dark);
    margin-bottom: 24px;
  }

  /* Card */
  .hosp-card {
    background: white;
    padding: 20px 22px;
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: flex-start;
    border-left: 3px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    cursor: default;
  }

  .hosp-card:hover {
    background: var(--cream-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
    border-left-color: var(--green-bright);
    z-index: 1;
    position: relative;
  }

  /* Network-specific left border at rest */
  .hosp-card.net-dor {
    border-left-color: rgba(232, 166, 36, 0.3);
  }
  .hosp-card.net-sus,
  .hosp-card.net-municipal {
    border-left-color: rgba(0, 120, 200, 0.2);
  }
  .hosp-card.net-americas {
    border-left-color: rgba(180, 0, 80, 0.2);
  }
  .hosp-card.net-particular {
    border-left-color: rgba(0, 184, 124, 0.15);
  }

  /* Avatar wrapper (for future logo support) */
  .hosp-avatar-wrap {
    flex-shrink: 0;
  }

  /* Initials block */
  .hosp-initials {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    background: linear-gradient(145deg, color-mix(in srgb, var(--bg) 90%, white 10%), var(--bg));
    color: var(--fg);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    position: relative;
    overflow: hidden;
  }

  /* D'Or gold accent stripe at bottom */
  .hosp-initials.net-dor::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #E8A624;
    opacity: 0.85;
  }

  /* SUS blue stripe at bottom */
  .hosp-initials.net-sus::after,
  .hosp-initials.net-municipal::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #0078C8;
    opacity: 0.7;
  }

  .initials-text {
    font-family: var(--sans);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .sus-label {
    font-family: var(--mono);
    font-size: 7px;
    font-weight: 500;
    letter-spacing: 0.06em;
    opacity: 0.75;
    line-height: 1;
  }

  /* Info column */
  .hosp-info {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hosp-name-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hosp-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    flex: 1;
    min-width: 0;
  }

  /* 24h emergency badge */
  .badge-24h {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--green-dark);
    background: rgba(0, 184, 124, 0.1);
    border: 1px solid rgba(0, 184, 124, 0.25);
    padding: 2px 6px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .dot-24h {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green-bright);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.75); }
  }

  .hosp-detail {
    font-size: 12px;
    color: var(--gray);
    line-height: 1.5;
  }

  /* Bottom row: tag + network badge */
  .hosp-bottom {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .hosp-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green-dark);
    background: rgba(0, 184, 124, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Network badges */
  .net-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .badge-dor {
    color: #7A5010;
    background: rgba(232, 166, 36, 0.15);
    border: 1px solid rgba(232, 166, 36, 0.3);
  }

  .badge-sus {
    color: #00528A;
    background: rgba(0, 120, 200, 0.1);
    border: 1px solid rgba(0, 120, 200, 0.25);
  }

  .badge-americas {
    color: #7A003A;
    background: rgba(180, 0, 80, 0.08);
    border: 1px solid rgba(180, 0, 80, 0.2);
  }

  /* Footer */
  .hosp-footer {
    font-size: 14px;
    color: var(--gray);
    line-height: 1.6;
    max-width: 680px;
    padding-top: 4px;
  }

  @media (max-width: 640px) {
    .hosp-grid {
      grid-template-columns: 1fr;
    }

    .hosp-initials {
      width: 48px;
      height: 48px;
      border-radius: 10px;
    }

    .initials-text {
      font-size: 14px;
    }
  }
</style>
