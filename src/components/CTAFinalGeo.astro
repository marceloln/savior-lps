---
import { CONTACT_RJ, CONTACT_SP, whatsappUrl } from '../data/savior';

interface Props {
  waCampaign: string;
  waMessage: string;
  ctaLabel?: string;
  contact?: typeof CONTACT_RJ;
  showSPPhone?: boolean;
  titleHtml?: string;
  subtitle?: string;
}

const {
  waCampaign,
  waMessage,
  ctaLabel = 'Chamar no WhatsApp',
  contact = CONTACT_RJ,
  showSPPhone = false,
  titleHtml = 'Manda mensagem. <em>Nós já estamos a caminho.</em>',
  subtitle = 'Central 24 horas. Atendemos em menos de 1 minuto, todos os dias do ano.',
} = Astro.props;

const waHref = whatsappUrl(contact.whatsapp, waCampaign, waMessage, 'cta-final');
---

<section class="cta-final-geo">
  <div class="cta-final-geo-bg" aria-hidden="true">
    <img src="/img/geo/ambulancia-motion.webp" alt="" width="1920" height="849" loading="lazy" />
  </div>
  <div class="cta-final-geo-overlay" aria-hidden="true"></div>

  <div class="cta-final-geo-inner">
    <h2 class="cta-final-geo-title" set:html={titleHtml} />
    <p class="cta-final-geo-sub">{subtitle}</p>
    <div class="cta-final-geo-btns">
      <a
        href={waHref}
        class="cta-geo-btn cta-geo-btn-green"
        data-whatsapp
        data-location="cta-final"
        data-campaign={waCampaign}
        target="_blank"
        rel="noopener"
      >{ctaLabel}</a>
      <a
        href={`tel:${contact.phoneHref}`}
        class="cta-geo-btn cta-geo-btn-outline"
        data-phone
        data-campaign={waCampaign}
        data-location="cta-final-phone"
      >{contact.phone}</a>
      {showSPPhone && (
        <a
          href={`tel:${CONTACT_SP.phoneLandlineHref}`}
          class="cta-geo-btn cta-geo-btn-outline"
          data-phone
          data-campaign={waCampaign}
          data-location="cta-final-phone-sp"
        >{CONTACT_SP.phoneLandline}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-final-geo {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 10vw, 120px) clamp(16px, 4vw, 48px);
    text-align: center;
  }

  /* Background aerial photo */
  .cta-final-geo-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-final-geo-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Navy overlay over the photo */
  .cta-final-geo-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(7, 24, 43, 0.78) 0%,
      rgba(11, 37, 64, 0.65) 50%,
      rgba(7, 24, 43, 0.75) 100%
    );
  }

  /* When no heroImage, use solid gradient as fallback */
  .cta-final-geo:not(:has(.cta-final-geo-bg)) .cta-final-geo-overlay {
    background: linear-gradient(135deg, var(--navy-deep, #07182B) 0%, var(--navy-mid, #143458) 100%);
  }

  .cta-final-geo-inner {
    position: relative;
    z-index: 2;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-final-geo-title {
    font-size: clamp(26px, 4.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 14px;
    color: #FAFAF8 !important;
    line-height: 1.1;
  }

  .cta-final-geo-title :global(em) {
    font-style: normal;
    color: var(--green-bright, #1FD29A);
  }

  .cta-final-geo-sub {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.65) !important;
    margin-bottom: 36px;
    line-height: 1.5;
  }

  .cta-final-geo-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-geo-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .cta-geo-btn-green {
    background: var(--green, #00B87C);
    color: white !important;
  }

  .cta-geo-btn-green:hover {
    background: var(--green-bright, #1FD29A);
    transform: translateY(-1px);
  }

  .cta-geo-btn-outline {
    background: rgba(255, 255, 255, 0.1);
    color: white !important;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
  }

  .cta-geo-btn-outline:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 480px) {
    .cta-final-geo-btns {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-geo-btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
