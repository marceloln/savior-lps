---
// ============================================================
// TempoGrid — Tabela de tempos de chegada por região
// Props: tempos (GeoTempo[])
// ============================================================

import type { GeoTempo } from '../data/geo-regions';

interface Props {
  tempos: GeoTempo[];
}

const { tempos } = Astro.props;
---

<section class="tempo-grid-section">
  <div class="wrap">
    <div class="tempo-head">
      <span class="eyebrow">TEMPO DE CHEGADA</span>
      <h2 class="tempo-h2">De onde saímos e <em>quanto tempo leva</em></h2>
      <p class="tempo-desc">
        Nossa base fica em São Cristóvão, na Zona Norte do Rio. Os tempos abaixo são médias — a central informa a estimativa real ao confirmar o chamado.
      </p>
    </div>

    <div class="tempo-grid">
      {tempos.map((tempo) => (
        <div class={`tempo-card${tempo.highlight ? ' tempo-card--highlight' : ''}`}>
          <div class="tempo-region">{tempo.region}</div>
          <div class="tempo-time">
            {tempo.time}
          </div>
          <div class="tempo-route">{tempo.route}</div>
        </div>
      ))}
    </div>

    <p class="tempo-disclaimer">
      Tempos médios, não garantidos. Variam conforme trânsito e condições no momento. A central informa a estimativa real ao confirmar o chamado.
    </p>
  </div>
</section>

<style>
  .tempo-grid-section {
    padding: var(--space-block) 0;
    background: var(--cream);
  }

  .tempo-head {
    max-width: 640px;
    margin-bottom: 40px;
  }

  .tempo-head .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .tempo-h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(22px, 3vw, 34px);
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--navy);
    margin-bottom: 14px;
  }

  .tempo-h2 em {
    font-style: normal;
    color: var(--green-dark);
  }

  .tempo-desc {
    font-size: 15px;
    color: var(--gray);
    line-height: 1.6;
  }

  /* Grid */
  .tempo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2px;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 16px;
    background: var(--cream-dark);
  }

  /* Card base */
  .tempo-card {
    background: white;
    padding: 24px;
    border-left: 3px solid var(--green);
    transition: background 0.15s;
  }

  .tempo-card:hover {
    background: var(--cream-light);
  }

  /* Card highlight (tempo.highlight === true) */
  .tempo-card--highlight {
    background: var(--navy);
    border-left-color: var(--green-bright);
  }

  .tempo-card--highlight:hover {
    background: var(--navy-mid);
  }

  /* Region name */
  .tempo-region {
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .tempo-card--highlight .tempo-region {
    color: white;
  }

  /* Time */
  .tempo-time {
    font-size: 28px;
    font-weight: 800;
    color: var(--green-dark);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 8px;
    font-family: var(--sans);
  }

  .tempo-card--highlight .tempo-time {
    color: var(--green-bright);
  }

  /* Route */
  .tempo-route {
    font-size: 12px;
    color: var(--gray);
    line-height: 1.5;
  }

  .tempo-card--highlight .tempo-route {
    color: rgba(255, 255, 255, 0.55);
  }

  /* Disclaimer */
  .tempo-disclaimer {
    font-size: 12px;
    font-style: italic;
    color: var(--gray);
    line-height: 1.5;
    max-width: 680px;
  }

  @media (max-width: 640px) {
    .tempo-grid {
      grid-template-columns: 1fr;
    }

    .tempo-time {
      font-size: 24px;
    }
  }
</style>
