# Redirects do Cloudflare Pages
# Formato: <source> <destination> <status>

# Raiz serve a home corporativa (index.astro)
# Redirect removido: / não redireciona mais para /ambulancia-rj

# Trailing slash: NÃO redirecionar — fix-trailing-slash.js cria dir/index.html
# para que ambas URLs sirvam conteúdo direto (preserva UTM/GA4 tracking)

# Normalizar maiúsculas → minúsculas
/CORPORATIVO /corporativo 301
/EVENTOS /eventos-rj 301
/EVENTOS-RJ /eventos-rj 301
/EVENTOS-SP /eventos-sp 301
/AMBULANCIA-RJ /ambulancia-rj 301
/AMBULANCIA-SP /ambulancia-sp 301

# URL antiga /eventos → /eventos-rj (301 permanente, preserva SEO)
/eventos /eventos-rj 301

# Geo pages: redirect URLs antigas (sem prefixo ambulancia) → novas
/ambulancia-rj/copacabana /ambulancia-rj/ambulancia-copacabana 301
/ambulancia-rj/zona-sul /ambulancia-rj/ambulancia-zona-sul 301
/ambulancia-rj/barra-recreio /ambulancia-rj/ambulancia-barra-recreio 301
/ambulancia-rj/zona-oeste /ambulancia-rj/ambulancia-zona-oeste 301
/ambulancia-rj/zona-norte /ambulancia-rj/ambulancia-zona-norte 301
/ambulancia-rj/niteroi /ambulancia-rj/ambulancia-niteroi 301
/ambulancia-rj/regiao-oceanica /ambulancia-rj/ambulancia-regiao-oceanica 301
/ambulancia-rj/regiao-serrana /ambulancia-rj/ambulancia-regiao-serrana 301
/ambulancia-rj/baixada-fluminense /ambulancia-rj/ambulancia-baixada-fluminense 301
/ambulancia-rj/centro /ambulancia-rj/ambulancia-centro 301
/ambulancia-rj/intermunicipal /ambulancia-rj/ambulancia-intermunicipal 301
/ambulancia-rj/buzios /ambulancia-rj/ambulancia-buzios 301
/ambulancia-rj/angra-dos-reis /ambulancia-rj/ambulancia-angra-dos-reis 301

